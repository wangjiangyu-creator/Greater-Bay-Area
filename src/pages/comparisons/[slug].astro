---
import { getCollection, render } from "astro:content";
import MetaList from "../../components/MetaList.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import StatusPill from "../../components/StatusPill.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byUpdatedDesc, displayDate } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("comparisons");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const topicIds = new Set(entry.data.topics);
const relatedTopics = (await getCollection("topics")).filter((topic) => topicIds.has(topic.id)).sort(byUpdatedDesc);
const relatedSources = (await getCollection("sources")).filter((source) => entry.data.relatedSources.includes(source.id)).sort(byUpdatedDesc);
const relatedCases = (await getCollection("cases")).filter((item) => item.data.topics.some((topic) => topicIds.has(topic))).sort(byUpdatedDesc);
const relatedGroups = [
  {
    title: "关联专题",
    items: relatedTopics.map((item) => ({ href: `/topics/${item.id}/`, title: item.data.title, meta: item.data.priority }))
  },
  {
    title: "关联法源",
    items: relatedSources.map((item) => ({ href: `/sources/${item.id}/`, title: item.data.title, meta: item.data.citation }))
  },
  {
    title: "同专题案例",
    items: relatedCases.map((item) => ({ href: `/cases/${item.id}/`, title: item.data.title, meta: item.data.batch }))
  }
];
---

<BaseLayout title={entry.data.title}>
  <section class="page-header">
    <span class="eyebrow">三法域规则对照</span>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.keyQuestions.join("；")}</p>
    <MetaList items={[displayDate(entry.data.updated)].concat(entry.data.regions)} />
    <div class="card-statuses">
      <StatusPill value={entry.data.status} />
      <StatusPill value={entry.data.visibility} />
    </div>
  </section>
  <article class="content-body">
    <Content />
  </article>
  <RelatedLinks groups={relatedGroups} />
</BaseLayout>
