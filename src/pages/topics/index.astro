---
import { getCollection } from "astro:content";
import EntryCard from "../../components/EntryCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byUpdatedDesc, countByStatus, uniqueSorted } from "../../lib/content";
import { withBase } from "../../lib/paths";

const entries = (await getCollection("topics")).sort(byUpdatedDesc);
const statusStats = countByStatus(entries);
const statusOptions = uniqueSorted(entries.map((entry) => entry.data.status));
const visibilityOptions = uniqueSorted(entries.map((entry) => entry.data.visibility));
const regionOptions = uniqueSorted(entries.flatMap((entry) => entry.data.regions));
const itemCount = entries.length;
const topicMatrix = [
  {
    title: "交易与争议解决",
    links: ["cross-border-dispute-resolution", "gba-lawyers-practice", "finance-connect"]
  },
  {
    title: "要素跨境流动",
    links: ["data-cross-border", "innovation-research-funding", "transport-customs-mobility", "talent-mobility"]
  },
  {
    title: "市场与公共服务软联通",
    links: ["standards-certification-market-access", "cross-border-public-services", "medical-products-connect", "professional-qualification"]
  },
  {
    title: "重大平台与服务贸易开放",
    links: ["major-cooperation-platforms-governance", "cepa-service-trade-access"]
  },
  {
    title: "数字治理与民生服务",
    links: ["digital-gba-governance", "cross-border-healthcare-eldercare", "data-cross-border", "cross-border-public-services"]
  }
];
const entriesById = new Map(entries.map((entry) => [entry.id, entry]));
---

<BaseLayout title="专题研究">
  <section class="page-header">
    <span class="eyebrow">专题研究</span>
    <h1>专题研究</h1>
    <p class="lede">每个专题都是总报告分章和论文写作的材料池。</p>
  </section>
  <section class="panel">
    <h2>专题状态分布</h2>
    <div class="status-stats">
      {Object.entries(statusStats).map(([status, count]) => (
        <p><strong>{count}</strong>{status}</p>
      ))}
    </div>
  </section>
  <section class="section">
    <h2>专题体系导读</h2>
    <div class="grid cards">
      {topicMatrix.map((group) => (
        <article class="panel">
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((slug) => {
              const entry = entriesById.get(slug);
              return entry ? <li><a href={withBase(`/topics/${entry.id}/`)}>{entry.data.title}</a></li> : null;
            })}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <section class="list-toolbar panel">
    <input id="topic-query" type="search" placeholder="关键词（标题/摘要）" aria-label="关键词检索" />
    <select id="topic-status" aria-label="状态筛选">
      <option value="">全部状态</option>
      {statusOptions.map((status) => <option value={status}>{status}</option>)}
    </select>
    <select id="topic-visibility" aria-label="公开性筛选">
      <option value="">全部公开性</option>
      {visibilityOptions.map((visibility) => <option value={visibility}>{visibility}</option>)}
    </select>
    <select id="topic-region" aria-label="适用区域筛选">
      <option value="">全部区域</option>
      {regionOptions.map((region) => <option value={region}>{region}</option>)}
    </select>
    <span id="topic-count" class="result-count">共 {itemCount} 条</span>
  </section>
  <div class="grid cards" id="topic-grid">
    {entries.map((entry) => (
      <div
        class="filter-item"
        data-title={entry.data.title}
        data-summary={entry.data.summary}
        data-status={entry.data.status}
        data-visibility={entry.data.visibility}
        data-regions={entry.data.regions.join(",")}
      >
        <EntryCard href={`/topics/${entry.id}/`} title={entry.data.title} summary={entry.data.summary} meta={[entry.data.priority, ...entry.data.regions.slice(0, 3)]} status={entry.data.status} visibility={entry.data.visibility} />
      </div>
    ))}
  </div>
  <script>
    const queryInput = document.getElementById("topic-query") as HTMLInputElement | null;
    const statusSelect = document.getElementById("topic-status") as HTMLSelectElement | null;
    const visibilitySelect = document.getElementById("topic-visibility") as HTMLSelectElement | null;
    const regionSelect = document.getElementById("topic-region") as HTMLSelectElement | null;
    const countHint = document.getElementById("topic-count") as HTMLElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>("#topic-grid .filter-item"));

    function renderTopicList() {
      const q = (queryInput && queryInput.value.trim().toLowerCase()) || "";
      const status = statusSelect ? statusSelect.value : "";
      const visibility = visibilitySelect ? visibilitySelect.value : "";
      const region = regionSelect ? regionSelect.value : "";

      let visible = 0;
      for (const item of items) {
        const title = (item.dataset.title || "").toLowerCase();
        const summary = (item.dataset.summary || "").toLowerCase();
        const itemStatus = item.dataset.status || "";
        const itemVisibility = item.dataset.visibility || "";
        const itemRegions = (item.dataset.regions || "").split(",").filter(Boolean);
        const show =
          (!q || title.includes(q) || summary.includes(q)) &&
          (!status || itemStatus === status) &&
          (!visibility || itemVisibility === visibility) &&
          (!region || itemRegions.includes(region));

        if (show) {
          item.classList.remove("is-hidden");
          visible += 1;
        } else {
          item.classList.add("is-hidden");
        }
      }
      if (countHint) countHint.textContent = `共 ${visible} 条`;
    }

    queryInput?.addEventListener("input", renderTopicList);
    statusSelect?.addEventListener("change", renderTopicList);
    visibilitySelect?.addEventListener("change", renderTopicList);
    regionSelect?.addEventListener("change", renderTopicList);
    renderTopicList();
  </script>
</BaseLayout>
