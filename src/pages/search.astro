---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const topics = await getCollection("topics");
const sources = await getCollection("sources");
const cases = await getCollection("cases");
const comparisons = await getCollection("comparisons");
const outputs = await getCollection("outputs");

type SearchItemData = {
  type: string;
  title: string;
  summary: string;
  href: string;
  tags: string[];
  status: string;
  visibility: string;
  language?: string;
};

const outputLanguageOptions = Array.from(new Set(outputs.map((entry) => entry.data.language).filter(Boolean) as string[])).sort();

const searchItems: SearchItemData[] = ([] as SearchItemData[])
  .concat(topics.map((entry) => ({ type: "专题", title: entry.data.title, summary: entry.data.summary, href: `/topics/${entry.id}/`, tags: entry.data.tags, status: entry.data.status, visibility: entry.data.visibility })))
  .concat(sources.map((entry) => ({ type: "法源", title: entry.data.title, summary: entry.data.summary, href: `/sources/${entry.id}/`, tags: [entry.data.issuer, entry.data.citation].concat(entry.data.tags), status: entry.data.status, visibility: entry.data.visibility })))
  .concat(cases.map((entry) => ({ type: "案例", title: entry.data.title, summary: entry.data.innovation, href: `/cases/${entry.id}/`, tags: [entry.data.legalBasis, entry.data.effect].concat(entry.data.mechanisms), status: entry.data.status, visibility: entry.data.visibility })))
  .concat(comparisons.map((entry) => ({ type: "对照", title: entry.data.title, summary: entry.data.keyQuestions.join("；"), href: `/comparisons/${entry.id}/`, tags: entry.data.mechanisms, status: entry.data.status, visibility: entry.data.visibility })))
  .concat(outputs.map((entry) => ({ type: "研究成果", title: entry.data.title, summary: entry.data.summary, href: `/outputs/${entry.id}/`, tags: entry.data.authors.concat(entry.data.keywords), status: entry.data.status, visibility: entry.data.visibility, language: entry.data.language })));

const serializedSearchItems = JSON.stringify(searchItems).replaceAll("<", "\\u003c");
---

<BaseLayout title="检索">
  <section class="page-header">
    <span class="eyebrow">检索</span>
    <h1>资料检索</h1>
    <p class="lede">按标题、摘要、标签和内容类型检索专题、法源、案例、规则对照和研究成果。</p>
  </section>

  <section class="panel">
    <div class="search-tools">
      <input id="q" type="search" placeholder="输入关键词" aria-label="检索关键词" />
      <select id="type" aria-label="内容类型">
        <option value="">全部类型</option>
        <option value="专题">专题</option>
        <option value="法源">法源</option>
        <option value="案例">案例</option>
        <option value="对照">对照</option>
        <option value="研究成果">研究成果</option>
      </select>
      <select id="output-language" aria-label="研究成果语言">
        <option value="">全部语言</option>
        {outputLanguageOptions.map((language) => <option value={language}>{language}</option>)}
      </select>
    </div>
    <div id="results" class="grid cards"></div>
  </section>

  <script type="application/json" id="search-data" set:html={serializedSearchItems} is:inline />
  <script>
    type SearchItem = {
      type: string;
      title: string;
      summary: string;
      href: string;
      tags?: string[];
      status: string;
      visibility: string;
      language?: string;
    };

    const input = document.querySelector<HTMLInputElement>("#q");
    const select = document.querySelector<HTMLSelectElement>("#type");
    const languageSelect = document.querySelector<HTMLSelectElement>("#output-language");
    const results = document.querySelector<HTMLElement>("#results");
    const dataElement = document.querySelector("#search-data");
    const data = JSON.parse(dataElement?.textContent || "[]") as SearchItem[];

    if (!input || !select || !results) {
      throw new Error("Search controls failed to initialize.");
    }

    const inputElement = input;
    const selectElement = select;
    const languageSelectElement = languageSelect;
    const resultsElement = results;

    function syncLanguageControl() {
      if (!languageSelectElement) return;
      const isResearchOutput = selectElement.value === "研究成果";
      languageSelectElement.disabled = !isResearchOutput;
      if (!isResearchOutput) {
        languageSelectElement.value = "";
      }
    }

    function render() {
      const query = inputElement.value.trim().toLowerCase();
      const type = selectElement.value;
      const language = languageSelectElement ? languageSelectElement.value : "";
      const filtered = data.filter((item) => {
        const isResearchOutput = item.type === "研究成果";
        const haystack = [item.type, item.title, item.summary, item.status, item.visibility].concat(item.tags || []).join(" ").toLowerCase();
        const passesLanguage = !language || !isResearchOutput || item.language === language;
        return (!type || item.type === type) && passesLanguage && (!query || haystack.includes(query));
      });

      resultsElement.replaceChildren(
        ...filtered.map((item) => {
          const article = document.createElement("article");
          article.className = "panel entry-card";

          const body = document.createElement("div");
          const heading = document.createElement("h3");
          const link = document.createElement("a");
          link.href = item.href;
          link.textContent = item.title;
          heading.append(link);

          const summary = document.createElement("p");
          summary.textContent = item.summary;
          body.append(heading, summary);

          const meta = document.createElement("ul");
          meta.className = "meta";
          const typeItem = document.createElement("li");
          typeItem.textContent = item.type;
          const statusItem = document.createElement("li");
          statusItem.textContent = item.status;
          const visibilityItem = document.createElement("li");
          visibilityItem.textContent = item.visibility;
          meta.append(typeItem, statusItem, visibilityItem);
          if (item.language) {
            const languageItem = document.createElement("li");
            languageItem.textContent = item.language;
            meta.append(languageItem);
          }

          article.append(body, meta);
          return article;
        })
      );
    }

    syncLanguageControl();
    inputElement.addEventListener("input", render);
    selectElement.addEventListener("change", () => {
      syncLanguageControl();
      render();
    });
    languageSelectElement?.addEventListener("change", render);
    render();
  </script>
</BaseLayout>
