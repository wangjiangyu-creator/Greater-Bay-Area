---
import { getCollection, render } from "astro:content";
import MetaList from "../../components/MetaList.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import StatusPill from "../../components/StatusPill.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byUpdatedDesc, displayDate } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("sources");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedTopics = (await getCollection("topics")).filter((topic) => entry.data.topics.includes(topic.id)).sort(byUpdatedDesc);
const relatedCases = (await getCollection("cases")).filter((item) => item.data.relatedSources.includes(entry.id)).sort(byUpdatedDesc);
const relatedComparisons = (await getCollection("comparisons")).filter((item) => item.data.relatedSources.includes(entry.id)).sort(byUpdatedDesc);
const relatedOutputs = (await getCollection("outputs")).filter((item) => item.data.relatedSources.includes(entry.id)).sort(byUpdatedDesc);
const relatedGroups = [
  {
    title: "关联专题",
    items: relatedTopics.map((item) => ({ href: `/topics/${item.id}/`, title: item.data.title, meta: item.data.priority }))
  },
  {
    title: "关联案例",
    items: relatedCases.map((item) => ({ href: `/cases/${item.id}/`, title: item.data.title, meta: item.data.batch }))
  },
  {
    title: "规则对照",
    items: relatedComparisons.map((item) => ({ href: `/comparisons/${item.id}/`, title: item.data.title, meta: item.data.status }))
  },
  {
    title: "研究成果",
    items: relatedOutputs.map((item) => ({ href: `/outputs/${item.id}/`, title: item.data.title, meta: item.data.outputType }))
  }
];
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <section class="page-header">
    <span class="eyebrow">政策与法源</span>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <MetaList items={[entry.data.issuer, entry.data.materialType, displayDate(entry.data.date)].concat(entry.data.regions)} />
    <div class="card-statuses">
      <StatusPill value={entry.data.status} />
      <StatusPill value={entry.data.visibility} />
    </div>
  </section>
  <section class="content-body">
    <h2>规则衔接关系</h2>
    <p>{entry.data.relationToRules}</p>
    <h2>机制对接关系</h2>
    <p>{entry.data.relationToMechanisms}</p>
    <h2>引用</h2>
    <p>{entry.data.citation}</p>
    <p><a href={entry.data.originalUrl}>原文链接</a>{entry.data.attachmentUrl && <> · <a href={entry.data.attachmentUrl}>附件</a></>}</p>
    <Content />
  </section>
  <RelatedLinks groups={relatedGroups} />
</BaseLayout>
